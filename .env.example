# Copy this file to .env and fill in your values.
# All variables have defaults (see internal/config/config.go) except
# RB_CONSUME_QUEUE, RB_HOST, RB_USERNAME, and RB_PASSWD, which you must set.

# --- RabbitMQ connection ---
RB_HOST=localhost
RB_PORT=5672
RB_VHOST=/
RB_USERNAME=guest
RB_PASSWD=guest

# --- Consumer ---
RB_CONSUME_QUEUE=dead_letter_queue
RB_CONSUMER_TAG=dead_queue_consumer
RB_WORKER_COUNT=1
RB_PREFETCH=1
AMQPR_CON_DELAY=5s

# --- Archive output ---
ARCHIVE_BASE_PATH=./archive

# --- Logging ---
LOG_FILE=./logs/app.log
LOG_MAX_SIZE_MB=50
LOG_MAX_BACKUPS=5
LOG_MAX_AGE_DAYS=14
LOG_COMPRESS=true
LOG_LEVEL=debug
LOG_CONSOLE=false

# --- republish tool (cmd/republish) ---
# TEST_AMQP_URL=amqp://user:pass@host:5672/
